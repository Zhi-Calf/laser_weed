<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tractor_monitor</name>
  <version>0.1.0</version>
  <description>System heartbeat monitor: watches every module except tractor_base, and heartbeats an aggregate verdict to tractor_base</description>
  <maintainer email="dev@tractor.local">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Deliberately minimal. Every monitored package depends on THIS one for
       heartbeat_publisher.hpp, so anything added here is added to all of them.
       tractor_monitor must never depend on a package that it monitors. -->
  <depend>rclcpp</depend>
  <depend>tractor_msgs</depend>

  <!-- 只有 monitor_node.cpp 用 spdlog, 且刻意不进 ament_export_dependencies,
       所以它不会传染给依赖本包 heartbeat_publisher.hpp 的六个包。 -->
  <depend>spdlog_vendor</depend>

  <!-- health_table.py 用 -->
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
