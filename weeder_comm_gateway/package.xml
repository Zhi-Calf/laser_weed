<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>weeder_comm_gateway</name>
  <version>0.2.0</version>
  <description>激光除草机通信网关: MQTT 云平台桥接与 APP 局域网 HTTP 路径服务</description>
  <maintainer email="dev@weeder.local">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>weeder_msgs</depend>
  <depend>spdlog_vendor</depend>
  <!-- MQTT 客户端: Eclipse Paho C++ 1.2+，底层自动拉入 Paho C 开发包 -->
  <depend>libpaho-mqttpp-dev</depend>
  <depend>libpaho-mqtt-dev</depend>
  <!-- JSON 编解码, 与 global_path_planner 同一个库; rosdep 键 nlohmann-json-dev -->
  <depend>nlohmann-json-dev</depend>
  <!-- http_bridge_node: HTTP 服务用随包 cpp-httplib，HTTPS 需要 OpenSSL。 -->
  <depend>libssl-dev</depend>
  <!-- http_bridge_node: 按 URL 下载路径文件，rosdep 键 libcurl-dev。 -->
  <depend>libcurl-dev</depend>
  <!-- http_bridge_node: ENU 转经纬度，rosdep 键 geographiclib。 -->
  <depend>geographiclib</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
