// Copyright 2026
// 激光除草机底盘驱动节点
//
// 架构：
//   ROS2 话题 <-> 本节点 <-> CanProtocol (编解码) <-> CanDriver (SocketCAN)
//
// 订阅：
//   /cmd_vel                 (geometry_msgs/msg/Twist)  速度指令
//   /weeder/lights/command   (weeder_msgs/LightCommand) 灯光控制
// 发布：
//   /weeder/chassis/state    (weeder_msgs/ChassisState) 全部底盘状态
//   /weeder/bms/state        (weeder_msgs/BmsState)     BMS 状态

#include "weeder_base/can_driver.hpp"
#include "weeder_base/can_protocol.hpp"

#include <rclcpp/rclcpp.hpp>
#include <geometry_msgs/msg/twist.hpp>
#include <std_msgs/msg/u_int8_multi_array.hpp>
#include <sensor_msgs/msg/imu.hpp>

#include <atomic>
#include <chrono>
#include <cmath>
#include <mutex>
#include <thread>
#include <unordered_set>

namespace weeder_base {

// ============================================================
// 简易自定义消息（直接用 std_msgs/geometry_msgs 避免依赖 weeder_msgs）
// 这里用 rosidl 生成的消息太重，改用 field 透传到 ROS 话题
// ============================================================

struct ChassisStateROS {
  // 从 decodeState01 映射
  uint8_t  gear{0};
  uint8_t  steer_mode{0};
  bool     estop{false};
  bool     reset{false};
  bool     release_brake{false};
  bool     ctrl_mode{false};       // false=遥控 true=无人
  double   speed_m_s{0.0};          // 物理值 m/s
  uint8_t  wheel_track_cm{0};
  // 灯光
  bool sound{false}, green{false}, yellow{false}, red{false};
  bool running_light{false}, turn_left{false}, turn_right{false};
  // 转向到位
  bool steer_done_fl{false}, steer_done_fr{false};
  bool steer_done_rl{false}, steer_done_rr{false};
  // 安全
  bool protect_bar{false}, bypass{false}, battery_charging{false}, battery_full{false};
  uint8_t alive_counter{0};
  // State02
  uint16_t motor_speed_fl{0}, motor_speed_fr{0}, motor_speed_rl{0}, motor_speed_rr{0};
  // State03
  double steer_angle_fl{0}, steer_angle_fr{0}, steer_angle_rl{0}, steer_angle_rr{0};
};

struct BmsStateROS {
  bool    power_on{false};
  uint8_t heating_status{0};
  uint8_t charge_status{0};
  uint8_t soh{0};
  double  soc{0};           // %
  double  voltage{0};       // V
  double  current{0};       // A (已加偏移)
  uint8_t error_level{0};
  uint8_t error_code{0};
  uint8_t fault_num{0};
  double  max_temp{0}, min_temp{0};
  uint8_t max_temp_pos{0}, min_temp_pos{0};
};

class ChassisNode : public rclcpp::Node {
 public:
  explicit ChassisNode(const std::string& interface)
      : Node("weeder_chassis_node"), interface_(interface) {
    // ---- 参数声明 ----
    declare_parameter("can_interface", interface_);
    declare_parameter("cmd_timeout_s", 0.5);       // 指令超时
    declare_parameter("vcu_timeout_s", 1.0);       // VCU 心跳超时
    declare_parameter("publish_hz", 20.0);
    declare_parameter("max_speed_m_s", 1.4);       // 最大线速度 1.4 m/s = 1400 mm/s
    declare_parameter("max_steer_deg", 90.0);
    get_params();

    // ---- CAN 驱动 ----
    can_driver_ = std::make_unique<CanDriver>(interface_);
    if (!can_driver_->open()) {
      RCLCPP_FATAL(this->get_logger(), "无法打开 CAN 接口 %s", interface_.c_str());
      throw std::runtime_error("CAN open failed");
    }

    // 设置接收滤波：只接收 VCU -> ADCU 的报文
    std::vector<uint32_t> ids = {
        can_id::CHASSIS_STATE_01, can_id::CHASSIS_STATE_02, can_id::CHASSIS_STATE_03,
        can_id::CHASSIS_STATE_04, can_id::CHASSIS_STATE_05, can_id::CHASSIS_STATE_06,
        can_id::CHASSIS_STATE_07, can_id::CHASSIS_STATE_08, can_id::CHASSIS_STATE_09,
        can_id::CHASSIS_STATE_10, can_id::CHASSIS_STATE_11,
        can_id::CHASSIS_STATE_21, can_id::CHASSIS_STATE_22, can_id::CHASSIS_STATE_23,
    };
    can_driver_->setFilters(ids);
    RCLCPP_INFO(this->get_logger(), "CAN 滤波已设置，监听 %zu 个报文 ID", ids.size());

    // 接收回调（在 CanDriver 的线程里调用）
    can_driver_->setReceiveCallback([this](const CanFrame& f) { onCanReceive(f); });
    can_driver_->startReceiveThread();

    // ---- 订阅 ----
    cmd_vel_sub_ = create_subscription<geometry_msgs::msg::Twist>(
        "/cmd_vel", 10, [this](const geometry_msgs::msg::Twist::SharedPtr msg) {
          onCmdVel(msg);
        });

    light_sub_ = create_subscription<std_msgs::msg::UInt8MultiArray(
        "/weeder/lights/command", 10, [this](const std_msgs::msg::UInt8MultiArray::SharedPtr msg) {
          onLightCommand(msg);
        });

    // ---- 发布 ----
    state_pub_ = create_publisher<std_msgs::msg::UInt8MultiArray>(
        "/weeder/chassis/state_raw", 10);  // 简化：用 raw 数组承载，配套解析见下方
    bms_pub_ = create_publisher<std_msgs::msg::UInt8MultiArray>(
        "/weeder/bms/state_raw", 10);

    // 用 String 话题发布人类可读状态（便于调试，不依赖自定义 msg 包）
    text_state_pub_ = create_publisher<std_msgs::msg::String>(
        "/weeder/chassis/state_text", 10);

    // ---- 定时器 ----
    // 发送指令定时器（20ms，与协议周期一致）
    send_timer_ = create_wall_timer(
        std::chrono::milliseconds(20), [this]() { sendCommandTimer(); });

    // 状态发布定时器（可配置频率）
    int pub_period_ms = static_cast<int>(1000.0 / publish_hz_);
    pub_timer_ = create_wall_timer(
        std::chrono::milliseconds(pub_period_ms), [this]() { publishState(); });

    RCLCPP_INFO(this->get_logger(), "激光除草机底盘节点已启动 (CAN=%s)", interface_.c_str());
  }

  ~ChassisNode() override {
    RCLCPP_INFO(this->get_logger(), "节点析构，停止接收线程");
    if (can_driver_) {
      can_driver_->stopReceiveThread();
      can_driver_->close();
    }
  }

 private:
  void get_params() {
    interface_     = get_parameter("can_interface").as_string();
    cmd_timeout_s_ = get_parameter("cmd_timeout_s").as_double();
    vcu_timeout_s_ = get_parameter("vcu_timeout_s").as_double();
    publish_hz_    = get_parameter("publish_hz").as_double();
    max_speed_m_s_ = get_parameter("max_speed_m_s").as_double();
    max_steer_deg_ = get_parameter("max_steer_deg").as_double();
  }

  // ============================================================
  // 接收处理（CanDriver 线程）
  // ============================================================
  void onCanReceive(const CanFrame& frame) {
    std::lock_guard<std::mutex> lock(state_mutex_);
    last_vcu_time_ = now();

    if (CanProtocol::decodeState01(frame, state01_)) {
      has_state01_ = true;
    } else if (CanProtocol::decodeState02(frame, state02_)) {
      has_state02_ = true;
    } else if (CanProtocol::decodeState03(frame, state03_)) {
      has_state03_ = true;
    } else if (CanProtocol::decodeState21(frame, state21_)) {
      has_state21_ = true;
    } else if (CanProtocol::decodeState22(frame, state22_)) {
      has_state22_ = true;
    } else if (CanProtocol::decodeState23(frame, state23_)) {
      has_state23_ = true;
    }
    // State 04~11 结构相同，用 decodeMotorState + 记录 ID
    MotorElecState m;
    if (CanProtocol::decodeMotorElec(frame, m)) {
      // 根据 frame.id 分发到对应轮
      if (frame.id == can_id::CHASSIS_STATE_04) { motor_fl_ = m; has_motor_fl_ = true; }
      else if (frame.id == can_id::CHASSIS_STATE_05) { motor_fr_ = m; has_motor_fr_ = true; }
      else if (frame.id == can_id::CHASSIS_STATE_06) { motor_rl_ = m; has_motor_rl_ = true; }
      else if (frame.id == can_id::CHASSIS_STATE_07) { motor_rr_ = m; has_motor_rr_ = true; }
    }
  }

  // ============================================================
  // /cmd_vel 回调（ROS 主线程）
  // ============================================================
  void onCmdVel(const geometry_msgs::msg::Twist::SharedPtr msg) {
    last_cmd_time_ = now();

    std::lock_guard<std::mutex> lock(cmd_mutex_);
    // 线速度 m/s -> 协议 raw（clamp 在 encode 内部做，这里只缓存物理值）
    cmd_linear_m_s_  = std::clamp(msg->linear.x, 0.0, max_speed_m_s_);
    // 角速度 -> 转向角近似（简单映射：ω -> 前轮转角，实际项目应替换为运动学模型）
    double steer_deg = std::clamp(std::abs(msg->angular.z) * 30.0, 0.0, max_steer_deg_);
    cmd_steer_deg_   = (msg->angular.z >= 0) ? steer_deg : -steer_deg;
  }

  void onLightCommand(const std_msgs::msg::UInt8MultiArray::SharedPtr msg) {
    // data[0] 作为位域：bit0=sound,1=green,2=yellow,3=red,4=running,5=left,6=right
    if (msg->data.empty()) return;
    std::lock_guard<std::mutex> lock(cmd_mutex_);
    uint8_t bits = msg->data[0];
    cmd_light_.tri_color_sound  = (bits >> 0) & 1;
    cmd_light_.tri_color_green  = (bits >> 1) & 1;
    cmd_light_.tri_color_yellow = (bits >> 2) & 1;
    cmd_light_.tri_color_red    = (bits >> 3) & 1;
    cmd_light_.running_light    = (bits >> 4) & 1;
    cmd_light_.turn_left        = (bits >> 5) & 1;
    cmd_light_.turn_right       = (bits >> 6) & 1;
  }

  // ============================================================
  // 发送定时器（20ms）
  // ============================================================
  void sendCommandTimer() {
    // ---- 安全检查 ----
    bool cmd_timeout = (now() - last_cmd_time_).seconds() > cmd_timeout_s_;
    bool vcu_timeout = has_state01_ && (now() - last_vcu_time_).seconds() > vcu_timeout_s_;

    AdcuCommand01 cmd{};
    {
      std::lock_guard<std::mutex> lock(cmd_mutex_);

      // 安全模式：超时或未收到 VCU -> 停车 + 保持急停状态
      if (cmd_timeout || vcu_timeout) {
        cmd.veh_speed_cmd = 0;      // 停车
        cmd.steer_angle_cmd = 0;
        cmd.estop_cmd = 1;           // 急停
        if (cmd_timeout && !warned_cmd_) {
          RCLCPP_WARN(this->get_logger(), "控制指令超时 (%.2fs)，自动停车",
                      (now() - last_cmd_time_).seconds());
          warned_cmd_ = true;
        }
      } else {
        cmd.veh_speed_cmd = CanProtocol::speedRawFromMps(cmd_linear_m_s_);
        cmd.steer_angle_cmd = CanProtocol::angleRawFromDeg(cmd_steer_deg_);
        cmd.estop_cmd = 0;
        warned_cmd_ = false;
      }

      // 从底盘状态复制驾驶模式 / 档位（跟随 VCU 反馈，保持一致性）
      cmd.gear_cmd        = state01_.gear;
      cmd.steer_mode_cmd  = state01_.steer_mode;
      cmd.ctrl_mode_cmd   = 1;   // 无人驾驶使能
      cmd.release_brake_cmd = 1; // 解除抱闸
      // 灯光命令
      cmd.tri_color_sound  = cmd_light_.tri_color_sound;
      cmd.tri_color_green  = cmd_light_.tri_color_green;
      cmd.tri_color_yellow = cmd_light_.tri_color_yellow;
      cmd.tri_color_red    = cmd_light_.tri_color_red;
      cmd.running_light    = cmd_light_.running_light;
      cmd.turn_left        = cmd_light_.turn_left;
      cmd.turn_right       = cmd_light_.turn_right;
    }

    cmd.alive_counter = alive_counter_++;
    CanFrame frame = CanProtocol::encodeAdcuCmd01(cmd);
    can_driver_->send(frame);
  }

  // ============================================================
  // 状态发布定时器
  // ============================================================
  void publishState() {
    std_msgs::msg::String msg;
    {
      std::lock_guard<std::mutex> lock(state_mutex_);

      auto& s = state01_;
      msg.data = fmtState(s);
    }
    text_state_pub_->publish(msg);

    // 结构化 raw 数据（配套 Python/上位机按协议解析）
    auto bms = packBms();
    bms_pub_->publish(bms);
  }

  std::string fmtState(const ChassisState01& s) {
    char buf[512];
    snprintf(buf, sizeof(buf),
        "[Chassis] gear=%u mode=%u ctrl=%s estop=%u speed=%.3f m/s wheel=%ucm | "
        "done=%u%u%u%u | bar=%u bypass=%u bat=%u/%u | alive=%u",
        s.gear, s.steer_mode, s.ctrl_mode ? "AUTO" : "RC", s.estop, s.speed_m_s,
        s.wheel_track_cm, s.steer_done_fl, s.steer_done_fr,
        s.steer_done_rl, s.steer_done_rr, s.protect_bar_signal, s.bypass_switch,
        s.battery_charging, s.battery_full, s.alive_counter);
    return std::string(buf);
  }

  std_msgs::msg::UInt8MultiArray packBms() {
    std_msgs::msg::U8MultiArray msg;
    // layout 省略，直接用 data 承载 8 字节原始 BMS 报文（如有），此处打包状态21关键字段
    // [0]=SOH [1]=SOC高 [2]=SOC低 ... 简化示意
    msg.data = {
        state21_.soh,
        static_cast<uint8_t>(state21_.soc >> 8),
        static_cast<uint8_t>(state21_.soc & 0xFF),
        state22_.error_level,
        static_cast<uint8_t>(state22_.max_temp + 40),  // 还原 raw
    };
    return msg;
  }

  // ============================================================
  // 成员
  // ============================================================
  std::string interface_;
  double cmd_timeout_s_{0.5}, vcu_timeout_s_{1.0}, publish_hz_{20.0};
  double max_speed_m_s_{1.4}, max_steer_deg_{90.0};

  std::unique_ptr<CanDriver> can_driver_;

  // 指令缓存（线程间共享）
  std::mutex cmd_mutex_;
  double  cmd_linear_m_s_{0};
  double  cmd_steer_deg_{0};
  AdcuCommand01 cmd_light_{};
  bool    warned_cmd_{false};

  // 状态缓存
  std::mutex state_mutex_;
  ChassisState01  state01_{};
  ChassisState02  state02_{};
  ChassisState03  state03_{};
  ChassisState21  state21_{};
  ChassisState22  state22_{};
  ChassisState23  state23_{};
  MotorElecState  motor_fl_, motor_fr_, motor_rl_, motor_rr_;
  bool has_state01_{false}, has_state02_{false}, has_state03_{false};
  bool has_state21_{false}, has_state22_{false}, has_state23_{false};
  bool has_motor_fl_{false}, has_motor_fr_{false}, has_motor_rl_{false}, has_motor_rr_{false};

  rclcpp::Time last_cmd_time_{0, 0, RCL_ROS_TIME};
  rclcpp::Time last_vcu_time_{0, 0, RCL_ROS_TIME};
  uint8_t alive_counter_{0};

  // ROS 接口
  rclcpp::Subscription<geometry_msgs::msg::Twist>::SharedPtr       cmd_vel_sub_;
  rclcpp::Subscription<std_msgs::msg::UInt8MultiArray>::SharedPtr    light_sub_;
  rclcpp::Publisher<std_msgs::msg::UInt8MultiArray>::SharedPtr       state_pub_;
  rclcpp::Publisher<std_msgs::msg::UInt8MultiArray>::SharedPtr       bms_pub_;
  rclcpp::Publisher<std_msgs::msg::String>::SharedPtr             text_state_pub_;
  rclcpp::TimerBase::SharedPtr send_timer_;
  rclcpp::TimerBase::SharedPtr pub_timer_;
};

}  // namespace weeder_base

// ============================================================
// main
// ============================================================
int main(int argc, char** argv) {
  rclcpp::init(argc, argv);

  std::string interface = "can0";
  if (argc > 1) interface = argv[1];

  try {
    auto node = std::make_shared<weeder_base::ChassisNode>(interface);
    rclcpp::spin(node);
  } catch (const std::exception& e) {
    RCLCPP_FATAL(rclcpp::get_logger("main"), "节点异常: %s", e.what());
    return 1;
  }

  rclcpp::shutdown();
  return 0;
}
