#!/usr/bin/env python3
"""Launch either an installed package or this source checkout, from any cwd."""
from pathlib import Path
import os
import sys

location = Path(__file__).resolve()
prefix = location.parent.parent
installed = prefix / "share" / "row_nav_calibration"
root = installed if (installed / "tools/field_assistant/server.py").is_file() else prefix
sys.path.insert(0, str(root))
from tools.field_assistant.server import FieldAssistantServer, build_parser, make_config

def main():
    data = Path(os.environ.get("ROW_NAV_CALIBRATION_DATA", str(
        Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) / "laser_weed/calibration"))).absolute()
    capture = prefix / "lib/row_nav_calibration/charuco_capture" if root == installed else root / "build/charuco_capture"
    parser = build_parser()
    parser.description = "laser_weed field calibration (default: simulation, localhost)"
    parser.set_defaults(workspace=data, sessions=Path("sessions"),
        runtime_calibration_dir=Path("runtime"), import_root=Path("imports"),
        capture_binary=capture, attitude_file=Path("attitude/live.json"))
    args = parser.parse_args()
    config = make_config(args)
    config.validate()
    if config.mode == "hardware" and not config.capture_binary.is_file():
        parser.error("Camera capture binary missing; build with ROW_NAV_CALIBRATION_BUILD_CAPTURE=ON or specify --capture-binary")
    server = FieldAssistantServer((args.host, args.port), config)
    print(f"Calibration page: http://{args.host}:{server.server_port}", flush=True)
    print(f"Mode: {config.mode}; sessions: {config.session_root}", flush=True)
    print(f"Runtime parameters: {config.effective_runtime_calibration_root}/current", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
