#!/usr/bin/env python3
"""Run with the ROS workspace's Python on the same host as the calibration web service."""
import argparse
import json
import math
import os
from pathlib import Path
import time
import uuid
from collections import deque


def main():
    parser = argparse.ArgumentParser(description='Read-only ROS pose bridge for calibration direction review')
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--installation-id', required=True, help='Change when device mounting or driver transform changes')
    parser.add_argument('--topic', default='/gnss_driver/pose')
    parser.add_argument('--frame', default='odom')
    args = parser.parse_args()
    import rclpy
    from rclpy.qos import qos_profile_sensor_data
    from weeder_msgs.msg import Pose
    rclpy.init()
    node = rclpy.create_node('row_nav_calibration_attitude_bridge')
    bridge_id = str(uuid.uuid4())
    history = deque(maxlen=512)
    previous = 0
    clock_fault = False
    args.output.parent.mkdir(parents=True, exist_ok=True)
    def receive(msg):
        nonlocal previous, clock_fault
        received = time.monotonic_ns()
        now = node.get_clock().now().nanoseconds
        stamp = msg.header.stamp.sec * 1000000000 + msg.header.stamp.nanosec
        if stamp <= previous or stamp > now:
            clock_fault = True
        previous = stamp
        age = (now - stamp) / 1e6
        valid = bool(msg.valid and not node.get_parameter("use_sim_time").value and not clock_fault and stamp > 0 and
                     0 <= msg.header.stamp.nanosec < 1000000000 and
                     msg.header.frame_id == args.frame and 0 <= age <= 200 and
                     all(math.isfinite(x) for x in (msg.roll, msg.pitch, msg.speed_m_s)))
        sample = dict(installation_id=args.installation_id, topic=args.topic,
            frame_id=msg.header.frame_id, bridge_id=bridge_id, stamp_ns=stamp,
            received_monotonic_ns=received, sample_monotonic_ns=received-(now-stamp), source_age_ms=age,
            publishers=node.count_publishers(args.topic), valid=valid,
            roll_rad=msg.roll if math.isfinite(msg.roll) else 0,
            pitch_rad=msg.pitch if math.isfinite(msg.pitch) else 0,
            speed_m_s=msg.speed_m_s if math.isfinite(msg.speed_m_s) else 0)
        history.append(dict(sample))
        sample["history"] = list(history)
        tmp = args.output.with_name(args.output.name + '.' + bridge_id + '.tmp')
        tmp.write_text(json.dumps(sample))
        os.replace(tmp, args.output)
    sub = node.create_subscription(Pose, args.topic, receive, qos_profile_sensor_data)
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_subscription(sub)
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
