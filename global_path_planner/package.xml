<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>global_path_planner</name>
  <version>0.1.0</version>
  <description>Bow-shaped coverage path planner for the laser weeder: YAML field polygon + ridge width -> weeder_msgs/Path</description>
  <maintainer email="1067401059@qq.com">JunJun</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclcpp、消息包与几何库都显式声明, 保证 rosdep 与单包构建完整。 -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>weeder_msgs</depend>
  <depend>spdlog_vendor</depend>
  <!-- find_package(Eigen3) —— 多边形/几何适配 (eigen_boost_adaptor.hpp); rosdep 键 eigen -->
  <depend>eigen</depend>
  <!-- find_package(Boost) —— Boost.Geometry (bg::length / bg::line_interpolate / 段几何) 是
       header-only, CMakeLists 用 find_package(Boost REQUIRED) 找它; rosdep 键 boost (libboost-dev)。
       ⚠ 必须在这里声明: 开发机上系统装了 boost 所以只靠 colcon 也能过, 但干净机器上
       rosdep install 不会装上它, 而本包支持"整目录单独拷出构建" (见 CMakeLists 顶部说明)。 -->
  <depend>boost</depend>
  <!-- GeographicLib (LocalCartesian): 经纬度 <-> ENU 平面; rosdep 键 geographiclib
       (Jammy/Humble 是 libgeographic-dev, Noble/Jazzy 是 libgeographiclib-dev, 见 CMakeLists) -->
  <depend>geographiclib</depend>
  <exec_depend>rviz2</exec_depend>

  <!-- 库 global_path_planner_lib (规划内核 + 节点实现) + 薄可执行文件。
       单测直接链该库，算法只编一遍。 -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <!-- 全覆盖路径规划的行为契约测试 (test/test_bow_planner.cpp) -->
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
