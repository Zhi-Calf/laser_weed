<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_vehicle</name>
  <version>0.1.0</version>
  <description>
    Simulation vehicle node for laser-weeder integration testing without hardware.
    Replaces gnss_localization (publishes /gnss_driver/pose, /gnss_driver/origin, TF
    odom->base_link) and the chassis (consumes /chassis/cmd, integrates
    a single-Ackermann bicycle model), and publishes /work_mode so that
    global_path_planner and path_tracker can be exercised end to end.
  </description>
  <maintainer email="jw11141@users.noreply.github.com">jw11141</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <!-- WorkMode definition, from the ported weeder_msgs package -->
  <exec_depend>weeder_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
