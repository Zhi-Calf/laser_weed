<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>path_tracker</name>
  <version>0.1.0</version>
  <description>
    Unified LQR path-tracking controller for the four-wheel-steering laser weeding
    robot. The global path uses LQR with Ackermann / four-wheel-steering
    kinematics; the optional row mode tracks crop-row centerlines with PID and
    falls back to global-path LQR.
  </description>
  <maintainer email="jw11141@users.noreply.github.com">jw11141</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend>
  <depend>weeder_msgs</depend>
  <depend>spdlog_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
